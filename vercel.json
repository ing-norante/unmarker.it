{
  "outputDirectory": "dist",
  "functions": {
    "api/sponsors.ts": {
      "includeFiles": "docs/legal/sponsor-terms.it.md"
    }
  },
  "redirects": [
    {
      "source": "/zh-hans",
      "destination": "/zh-hans/",
      "statusCode": 301
    },
    {
      "source": "/zh-Hans",
      "destination": "/zh-hans/",
      "statusCode": 301
    },
    {
      "source": "/zh-Hans/",
      "destination": "/zh-hans/",
      "statusCode": 301
    },
    {
      "source": "/zh-hans/index.html",
      "destination": "/zh-hans/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/legal/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src https://vercel.live; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://z.unmarker.it https://eu-assets.i.posthog.com https://vercel.live; connect-src 'self' data: https://z.unmarker.it https://eu.i.posthog.com https://*.posthog.com https://vercel.live; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/legal/sponsorship-terms",
      "destination": "/legal/sponsorship-terms/index.html"
    },
    {
      "source": "/legal/privacy",
      "destination": "/legal/privacy/index.html"
    },
    {
      "source": "/legal/cookies",
      "destination": "/legal/cookies/index.html"
    },
    {
      "source": "/legal/cancellations-refunds",
      "destination": "/legal/cancellations-refunds/index.html"
    }
  ]
}
