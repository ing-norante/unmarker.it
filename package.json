{
  "name": "unmarker.it",
  "version": "1.1.0",
  "description": "A 100% client-side AI watermark disruptor. Process images entirely in your browser.",
  "license": "MIT",
  "author": {
    "name": "Ing. Norante",
    "url": "https://www.unmarker.it"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ing-norante/unmarker.it.git"
  },
  "homepage": "https://www.unmarker.it",
  "bugs": {
    "url": "https://github.com/ing-norante/unmarker.it/issues"
  },
  "keywords": [
    "ai",
    "watermark",
    "watermark-remover",
    "image-processing",
    "client-side",
    "privacy",
    "canvas",
    "browser"
  ],
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs && node scripts/verify-localization.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@techstark/opencv-js": "4.12.0-release.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.417.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
