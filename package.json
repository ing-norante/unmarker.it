{
  "name": "unmarker.it",
  "version": "1.1.0",
  "description": "A 100% client-side AI watermark disruptor. Process images entirely in your browser.",
  "license": "MIT",
  "author": {
    "name": "Ing. Norante",
    "url": "https://www.unmarker.it"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ing-norante/unmarker.it.git"
  },
  "homepage": "https://www.unmarker.it",
  "bugs": {
    "url": "https://github.com/ing-norante/unmarker.it/issues"
  },
  "keywords": [
    "ai",
    "watermark",
    "watermark-remover",
    "image-processing",
    "client-side",
    "privacy",
    "canvas",
    "browser"
  ],
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs && node scripts/verify-localization.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "tailwind:fix": "tailwind-lint --auto --fix",
    "sponsors:db:up": "docker compose -p unmarker-sponsors-5486 -f compose.sponsors.yml up -d --wait",
    "sponsors:db:migrate": "node --env-file=.env --import tsx scripts/sponsors-db.ts",
    "sponsors:api": "node --env-file=.env --import tsx scripts/sponsors-api.ts",
    "sponsors:billing:export": "node --env-file=.env --import tsx scripts/sponsors-billing-export.ts",
    "sponsors:reconcile": "node --env-file=.env --import tsx scripts/sponsors-reconcile.ts",
    "sponsors:stripe:setup": "node --env-file=.env --import tsx scripts/sponsors-stripe-setup.ts",
    "sponsors:stripe:listen": "node --env-file=.env scripts/sponsors-stripe-listen.mjs",
    "sponsors:test": "node --env-file=.env scripts/sponsors-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@techstark/opencv-js": "4.12.0-release.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "i18next": "^26.4.2",
    "pg": "8.23.0",
    "posthog-js": "^1.433.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "shadcn": "^4.21.0",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "stripe": "22.6.2",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stripe/cli": "1.50.11",
    "@types/node": "^25.9.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-lint": "^0.12.1",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.4.2"
}
