# Server only: never prefix these secrets with VITE_.
STRIPE_PRIVATE_KEY=sk_test_replace_me
STRIPE_ACCOUNT_ID=acct_replace_with_sandbox_account
# Hosted Checkout does not need this key in the browser.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
DATABASE_URL=postgresql://unmarker:local-development-only@127.0.0.1:55486/unmarker_sponsors
# Optional dedicated connection; takes precedence in the API, migrations and test runner.
# Use a separate Neon branch for online previews.
SPONSOR_DATABASE_URL=
SPONSOR_APP_URL=http://localhost:5173
SPONSOR_SESSION_SECRET=replace_with_at_least_32_random_characters
CRON_SECRET=replace_with_at_least_32_random_characters
# Test keys only unless explicitly enabled after production configuration and QA.
SPONSOR_ALLOW_LIVE_PAYMENTS=false
# Enable live countries only after fiscal review and publication of final terms.
SPONSOR_APPROVED_BILLING_COUNTRIES=
# Optional server analytics. Use the existing project key and ingestion host.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
